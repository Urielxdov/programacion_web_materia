# Copia este archivo a .env y completa los valores. .env está ignorado por Git.
UNIDAD2_MAIL_MODE=smtp
UNIDAD2_MAIL_TO=destinatario@ejemplo.com
UNIDAD2_MAIL_FROM=remitente@ejemplo.com
UNIDAD2_SMTP_HOST=smtp.gmail.com
UNIDAD2_SMTP_PORT=587
# tls = STARTTLS (587) | ssl = SSL implícito (465) | none
UNIDAD2_SMTP_SECURE=tls
UNIDAD2_SMTP_USER=remitente@ejemplo.com
UNIDAD2_SMTP_PASS=contraseña-o-contraseña-de-aplicación
