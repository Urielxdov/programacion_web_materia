# Copia este archivo como .env y ajusta los valores. .env NO se sube al repositorio.

APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Mexico_City
APP_INSTITUCION="Instituto Tecnológico"
# true solo detrás de un proxy que agregue X-Forwarded-Proto (Render)
TRUST_PROXY=false
SESSION_MINUTES=30

# --- Opción A: MySQL / MariaDB de XAMPP ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ewaste360
DB_USER=root
DB_PASSWORD=

# --- Opción B: PostgreSQL (Neon). Si existe, tiene prioridad sobre DB_* ---
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/ewaste360?sslmode=require

# Contraseña de las cuentas demo que crea database/instalar.php (mínimo 8 caracteres, letras y números)
# SEED_PASSWORD=
