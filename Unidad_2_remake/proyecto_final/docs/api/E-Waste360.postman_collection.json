{
  "info": {
    "name": "E-Waste 360° API",
    "description": "Servicios web de E-Waste 360°. Ejecuta primero 'Iniciar sesión': guarda el token CSRF en la variable csrf. Postman conserva la cookie de sesión automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "usuario",
      "value": "responsable"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "equipoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('csrf', pm.response.json().csrf_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Servicio 1 - Equipos",
      "item": [
        {
          "name": "Listar equipos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/equipos?q=dell&por_pagina=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipos"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "dell"
                },
                {
                  "key": "por_pagina",
                  "value": "10"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y paginación', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().meta).to.have.property('total'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle de equipo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/equipos/{{equipoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipos",
                "{{equipoId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Registrar equipo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/equipos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoria_id\": 2,\n  \"marca\": \"HP\",\n  \"modelo\": \"ProBook 440 G5\",\n  \"anio_fabricacion\": 2020,\n  \"fecha_ingreso\": \"2026-11-10\",\n  \"condicion\": \"falla_parcial\",\n  \"peso_kg\": 1.7\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('equipoId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar equipo inválido (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/equipos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoria_id\": 2,\n  \"marca\": \"\",\n  \"modelo\": \"X\",\n  \"fecha_ingreso\": \"2999-01-01\",\n  \"condicion\": \"rota\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 con detalles', () => { pm.response.to.have.status(422); pm.expect(pm.response.json().error.detalles).to.have.property('marca'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar ubicación (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/equipos/{{equipoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipos",
                "{{equipoId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ubicacion\": \"Laboratorio 4\"\n}"
            }
          }
        },
        {
          "name": "Recomendación de destino",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/equipos/{{equipoId}}/recomendacion?estado_funcional=falla_parcial&costo_reparacion=1500&valor_reemplazo=9000&riesgo_seguridad=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipos",
                "{{equipoId}}",
                "recomendacion"
              ],
              "query": [
                {
                  "key": "estado_funcional",
                  "value": "falla_parcial"
                },
                {
                  "key": "costo_reparacion",
                  "value": "1500"
                },
                {
                  "key": "valor_reemplazo",
                  "value": "9000"
                },
                {
                  "key": "riesgo_seguridad",
                  "value": "0"
                }
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Servicio 2 - Indicadores",
      "item": [
        {
          "name": "Indicadores generales",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/indicadores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "indicadores"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Resultados de campañas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/indicadores/campanas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "indicadores",
                "campanas"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Reutilización y reparación",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/indicadores/reutilizacion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "indicadores",
                "reutilizacion"
              ]
            },
            "description": ""
          }
        }
      ]
    }
  ]
}