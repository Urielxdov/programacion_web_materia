# Configuracion de sendmail (msmtp) para el contenedor "citas".
# Por defecto entrega a Mailpit (bandeja local, http://localhost:8025): no envia nada a internet.
defaults
auth off
tls off
logfile /tmp/msmtp.log

account default
host mailpit
port 1025
from formulario@equipo1.local

