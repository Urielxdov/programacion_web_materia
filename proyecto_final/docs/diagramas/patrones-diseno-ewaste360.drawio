        <mxCell id="12" value="Se muestra EquiposRepository como ejemplo. Otros repositorios heredan la misma base; IndicadoresRepository usa DataSource directamente. La separación es práctica: EquiposService ejecuta un bloqueo SQL de folios dentro de una transacción y algunos servicios coordinan EntityManager." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=note;fillColor=#fff2cc;strokeColor=#d6b656;align=left;">
          <mxGeometry as="geometry" x="40" y="790" width="1340" height="120" />
