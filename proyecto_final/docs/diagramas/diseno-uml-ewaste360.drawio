        <mxCell id="n36" value="El cambio de destino y el movimiento comparten transacción. Las decisiones ENVIO_REPARACION, REASIGNACION y CONSERVACION usan el mismo servicio con métodos y validaciones específicos de Equipo; no necesitan emitir un evento adicional para este historial." parent="1" vertex="1" style="fontFamily=Helvetica;fontSize=14;whiteSpace=wrap;html=0;shape=note;size=15;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;fontSize=13;">
          <mxGeometry as="geometry" x="35" y="1425" width="1970" height="58" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
