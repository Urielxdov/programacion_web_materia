          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n27" value="entregarAGestor(...)&#10;[gestor verificado, evidencia y borrado si aplica]" parent="1" edge="1" style="fontFamily=Helvetica;fontSize=12;whiteSpace=nowrap;html=0;labelBackgroundColor=#ffffff;strokeColor=#475569;endArrow=none;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" source="n10" target="n14">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n28" value="Disponible = EN_INVENTARIO o CONSERVADO.&#10;conservar(ubicacion): disponible + condición distinta de GESTION_ESPECIALIZADA → CONSERVADO; preserva la condición.&#10;Un equipo conservado puede volver a diagnosticarse o seguir a reparación / reasignación / entrega si cumple las reglas.&#10;Diagnosticar no cambia estadoDestino; puede repetirse mientras no esté en reparación ni tenga destino final.&#10;La reparación devuelve EN_INVENTARIO y actualiza la condición.&#10;REASIGNADO y ENTREGADO_GESTOR no admiten nuevos cambios. La entrega no prueba reciclaje efectivo." parent="1" vertex="1" style="fontFamily=Helvetica;fontSize=14;whiteSpace=wrap;html=0;shape=note;size=15;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;fontSize=13;">
          <mxGeometry as="geometry" x="35" y="1440" width="1780" height="210" />
        </mxCell>
        <mxCell id="n29" value="Diagrama de estados resumido con condiciones agrupadas. Todas las transiciones requieren autorización en el servidor; las guardas se completan con las reglas descritas en el Markdown." parent="1" vertex="1" style="fontFamily=Helvetica;fontSize=14;whiteSpace=wrap;html=0;shape=note;size=15;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;fontSize=13;">
          <mxGeometry as="geometry" x="555" y="1225" width="740" height="120" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
