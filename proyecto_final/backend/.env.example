# Copia este archivo como .env y ajusta los valores.
NODE_ENV=development
PORT=3000

# Cadena de conexión PostgreSQL (local con docker compose o Neon en producción)
DATABASE_URL=postgres://ewaste:ewaste_dev@localhost:5544/ewaste360
# true en Neon/producción (requiere SSL)
DB_SSL=false

# Secretos largos y aleatorios (ej. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
SESSION_SECRET=cambia-este-secreto-de-sesion-por-uno-largo-y-aleatorio
CSRF_SECRET=cambia-este-secreto-csrf-por-uno-largo-y-aleatorio

# Contraseña de las cuentas demo que crea el seed (no uses contraseñas personales)
SEED_DEMO_PASSWORD=Demo2026!
# Crea las cuentas demo faltantes al arrancar Nest (sin cargar equipos de ejemplo).
SEED_ON_START=true
